# Copy to .env and fill in.
# Get all three from https://trovefiles.dev/dashboard

# Workspace ID (ws-...) shown when you provisioned the workspace.
TROVE_WORKSPACE_ID=ws-...

# Admin key (scope: admin) — mints/revokes keys, manages webhooks.
# Lives ONLY in your backend secrets manager. Never ships to agent processes.
TROVE_ADMIN_KEY=trove-sk-...

# Unscoped runtime key (scope: workspace, no namespace) — used by the ops
# dashboard to read across every active session's namespace.
# Don't pass this to agent processes — they get scoped, throwaway keys.
TROVE_RUNTIME_KEY=trove-sk-...
