# Copy this file to examples/.env and fill in your values.
# Never commit .env to version control.

# Trove — get from https://trovefiles.dev/dashboard
TROVE_API_KEY=trove-sk-...

# Anthropic — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── For shopping_agent.py and personal_assistant.py ─────────────────────────

# Admin-scope key. Manages keys/webhooks at the workspace level.
TROVE_ADMIN_KEY=trove-sk-...

# Workspace-scope key with NO namespace lock — caller picks namespace per request.
TROVE_SHOPPING_KEY=trove-sk-...

# Workspace-scope key LOCKED to a single namespace. Requests outside it are rejected.
TROVE_PERSONAL_KEY=trove-sk-...
TROVE_PERSONAL_NAMESPACE=user_id
